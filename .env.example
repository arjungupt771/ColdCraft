# ─── App ────────────────────────────────────────────
APP_ENV=development                 # development | production
# REQUIRED in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
DATABASE_URL=sqlite+aiosqlite:///./coldcraft.db

# ─── Security ───────────────────────────────────────
# Shared token the frontend sends as X-API-Token. Empty = auth off (dev only; REQUIRED in production).
# Set the SAME value as VITE_API_TOKEN in frontend/.env
API_TOKEN=
# Fernet key that encrypts Gmail tokens at rest. REQUIRED in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (In development an auto-generated key is stored in backend/.coldcraft_fernet.key)
TOKEN_ENCRYPTION_KEY=
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AI_PER_MINUTE=20

# ─── AI providers (at least one; order = fallback order) ─
AI_PROVIDER_ORDER=["groq","gemini","openai"]
GROQ_API_KEY=your_groq_key_here          # console.groq.com
GROQ_MODEL=openai/gpt-oss-120b           # check console.groq.com/docs/models for current IDs
GEMINI_API_KEY=your_gemini_key_here      # aistudio.google.com/app/apikey (also needed for screenshot OCR unless OPENAI_API_KEY set)
OPENAI_API_KEY=                          # optional third provider / vision fallback
# Pin a prompt version (default = newest in backend/app/prompts/<name>/)
# PROMPT_VERSION_EMAIL_GENERATION=v1

# ─── Gmail OAuth2 ───────────────────────────────────
# console.cloud.google.com → Create project → Enable Gmail API → OAuth credentials
GMAIL_CLIENT_ID=your_client_id
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback

# ─── Hunter.io (optional, free tier) ────────────────
HUNTER_API_KEY=your_hunter_key           # hunter.io

# ─── Background processing ──────────────────────────
REDIS_URL=redis://localhost:6379/0       # only needed to run the Celery worker + beat
FOLLOWUP_AUTO_SEND=false                 # true = worker sends due follow-ups automatically
FOLLOWUP_CHECK_INTERVAL_MINUTES=15
INPROCESS_SCHEDULER=true                 # set false when running Celery beat
